!/wordpress-*/
!/wordpress-*/**
!/at-view-table/
!/at-view-table/**
!/barber-booking/
!/barber-booking/**

# Local/environment files.
.env
.env.local

# OS / IDE / logs.
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-*
*.log

# Node / build artifacts.
node_modules/
