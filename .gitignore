# Ignore everything at repo root by default.
/*

# Keep repo metadata/docs.
!/.gitignore
!/README.md

# Keep WordPress plugin directories.
!/wordpress-*/
!/wordpress-*/**

# Local/environment files.
.env
.env.local

# OS / IDE / logs.
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-*
*.log

# Node / build artifacts.
node_modules/
